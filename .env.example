# Immutable locally built image IDs. Credentials stay in server-only secrets/.
BRIDGE_IMAGE=sha256:replace_with_built_bridge_image_id
CONNECTOR_IMAGE=sha256:replace_with_built_connector_image_id
WORKER_IMAGE=sha256:replace_with_built_worker_image_id
DELIVERY_IMAGE=sha256:replace_with_built_delivery_image_id
